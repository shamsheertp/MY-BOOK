# ==========================================
# MY-BOOK Full Stack Production Environment
# ==========================================

# Backend Configuration
PORT=5000
NODE_ENV=production
DATABASE_URL="postgresql://username:password@host:port/database?connection_limit=10&pool_timeout=20"
JWT_SECRET="generate_a_secure_random_key_here_e_g_using_openssl_rand_base64_32"
JWT_EXPIRES_IN="7d"
CLIENT_URL="https://app.yourdomain.com"
ADMIN_PIN="1234"

# Cloudflare R2 Document Storage
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="mybook-documents"
R2_PUBLIC_URL="https://pub-xxxxxxxxxxxxxxxx.r2.dev"

# Frontend Configuration
VITE_API_URL="/api"
