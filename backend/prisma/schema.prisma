generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  ACCOUNTANT
  USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id          String     @id @default(uuid())
  name        String
  email       String     @unique
  password    String
  role        Role       @default(USER)
  status      UserStatus @default(ACTIVE)
  phone       String?
  avatar      String?
  lastLoginAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

model CompanyProfile {
  id                String   @id @default(uuid())
  companyName       String   @default("Capital Metal Craft")
  tagline           String?
  logo              String?  @db.Text
  email             String?
  phone             String?
  website           String?
  addressLine1      String?
  addressLine2      String?
  city              String?
  state             String?
  pincode           String?
  country           String?  @default("India")
  gstin             String?
  pan               String?
  bankName          String?
  accountHolder     String?
  accountNumber     String?
  ifsc              String?
  upiId             String?
  invoiceTerms      String?  @db.Text
  footerNote        String?
  signatoryName     String?
  showBankOnInvoice Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("company_profiles")
}

model Contact {
  id          String      @id @default(uuid())
  code        String?     @unique
  contactName String
  companyName String?
  email       String?
  phone       String?
  taxNumber   String?
  address     String?     @db.Text
  notes       String?     @db.Text
  receivables Decimal     @default(0.00) @db.Decimal(12, 2)
  payables    Decimal     @default(0.00) @db.Decimal(12, 2)
  avatar      String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  sales       Sale[]
  purchases   Purchase[]
  expenses    Expense[]

  @@index([contactName])
  @@index([companyName])
  @@index([phone])
  @@index([email])
  @@map("contacts")
}

model Product {
  id                String     @id @default(uuid())
  sku               String     @unique
  name              String
  category          String     @default("General")
  costPricePerKg    Decimal    @default(0.00) @db.Decimal(12, 2)
  sellingPricePerKg Decimal    @default(0.00) @db.Decimal(12, 2)
  stockKg           Decimal    @default(0.00) @db.Decimal(12, 2)
  minStockKg        Decimal    @default(10.00) @db.Decimal(12, 2)
  unit              String     @default("kg")
  description       String?    @db.Text
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  saleItems     SaleItem[]
  purchaseItems PurchaseItem[]

  @@index([name])
  @@index([category])
  @@map("products")
}

enum SaleStatus {
  DRAFT
  UNPAID
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
  VOID
}

model Sale {
  id              String        @id @default(uuid())
  ref             String        @unique
  date            DateTime      @default(now())
  dueDate         DateTime?
  customerId      String?
  customerName    String
  customerCompany String?
  customerEmail   String?
  customerPhone   String?
  customerAddress String?       @db.Text
  status          SaleStatus    @default(UNPAID)
  subtotal        Decimal       @default(0.00) @db.Decimal(12, 2)
  discount        Decimal       @default(0.00) @db.Decimal(12, 2)
  tax             Decimal       @default(0.00) @db.Decimal(12, 2)
  taxPercent      Decimal       @default(0.00) @db.Decimal(5, 2)
  total           Decimal       @default(0.00) @db.Decimal(12, 2)
  received        Decimal       @default(0.00) @db.Decimal(12, 2)
  balance         Decimal       @default(0.00) @db.Decimal(12, 2)
  notes           String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  contact         Contact?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items           SaleItem[]
  payments        SalePayment[]

  @@index([status])
  @@index([date])
  @@index([customerId])
  @@index([createdAt])
  @@map("sales")
}

model SaleItem {
  id          String   @id @default(uuid())
  saleId      String
  productId   String?
  name        String
  quantityKg  Decimal  @default(1.00) @db.Decimal(12, 2)
  unitPrice   Decimal  @default(0.00) @db.Decimal(12, 2)
  total       Decimal  @default(0.00) @db.Decimal(12, 2)

  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model SalePayment {
  id        String   @id @default(uuid())
  saleId    String
  ref       String
  date      DateTime @default(now())
  amount    Decimal  @default(0.00) @db.Decimal(12, 2)
  method    String   @default("Bank Transfer")
  notes     String?
  image     String?
  voided    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([date])
  @@map("sale_payments")
}

enum PurchaseStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  COMPLETED
  CANCELLED
  VOID
}

model Purchase {
  id                   String            @id @default(uuid())
  ref                  String            @unique
  date                 DateTime          @default(now())
  expectedDeliveryDate DateTime?
  supplierId           String?
  supplierName         String
  supplierCompany      String?
  supplierEmail        String?
  supplierPhone        String?
  supplierAddress      String?           @db.Text
  status               PurchaseStatus    @default(ORDERED)
  subtotal             Decimal           @default(0.00) @db.Decimal(12, 2)
  discount             Decimal           @default(0.00) @db.Decimal(12, 2)
  tax                  Decimal           @default(0.00) @db.Decimal(12, 2)
  taxPercent           Decimal           @default(0.00) @db.Decimal(5, 2)
  total                Decimal           @default(0.00) @db.Decimal(12, 2)
  paid                 Decimal           @default(0.00) @db.Decimal(12, 2)
  balance              Decimal           @default(0.00) @db.Decimal(12, 2)
  notes                String?           @db.Text
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  supplier             Contact?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  items                PurchaseItem[]
  receipts             PurchaseReceipt[]
  bills                PurchaseBill[]
  payments             PurchasePayment[]

  @@index([status])
  @@index([date])
  @@index([supplierId])
  @@index([createdAt])
  @@map("purchases")
}

model PurchaseItem {
  id         String   @id @default(uuid())
  purchaseId String
  productId  String?
  name       String
  orderedKg  Decimal  @default(1.00) @db.Decimal(12, 2)
  receivedKg Decimal  @default(0.00) @db.Decimal(12, 2)
  billedKg   Decimal  @default(0.00) @db.Decimal(12, 2)
  unitPrice  Decimal  @default(0.00) @db.Decimal(12, 2)
  total      Decimal  @default(0.00) @db.Decimal(12, 2)

  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product    Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

model PurchaseReceipt {
  id            String   @id @default(uuid())
  purchaseId    String
  ref           String
  date          DateTime @default(now())
  itemsReceived Decimal  @default(0.00) @db.Decimal(12, 2)
  status        String   @default("Received")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  purchase      Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
  @@map("purchase_receipts")
}

model PurchaseBill {
  id         String    @id @default(uuid())
  purchaseId String
  ref        String
  date       DateTime  @default(now())
  dueDate    DateTime?
  amount     Decimal   @default(0.00) @db.Decimal(12, 2)
  paid       Decimal   @default(0.00) @db.Decimal(12, 2)
  balance    Decimal   @default(0.00) @db.Decimal(12, 2)
  status     String    @default("UNPAID")
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  purchase   Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
  @@index([status])
  @@map("purchase_bills")
}

model PurchasePayment {
  id         String   @id @default(uuid())
  purchaseId String
  billId     String?
  ref        String
  date       DateTime @default(now())
  amount     Decimal  @default(0.00) @db.Decimal(12, 2)
  method     String   @default("Bank Transfer")
  notes      String?
  image      String?
  voided     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
  @@index([billId])
  @@index([date])
  @@map("purchase_payments")
}

enum ExpenseStatus {
  PAID
  PENDING
  CANCELLED
  VOID
}

model ExpenseCategory {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  color       String?   @default("#6366f1")
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  expenses    Expense[]

  @@map("expense_categories")
}

model Expense {
  id            String           @id @default(uuid())
  ref           String           @unique
  date          DateTime         @default(now())
  category      String
  categoryId    String?
  amount        Decimal          @default(0.00) @db.Decimal(12, 2)
  tax           Decimal          @default(0.00) @db.Decimal(12, 2)
  paymentMethod   String           @default("Credit Card")
  paymentMethodId String?
  status          ExpenseStatus    @default(PAID)
  description     String?          @db.Text
  payee           String?
  contactId       String?
  referenceNo     String?
  receiptImage    String?          @db.Text
  notes           String?          @db.Text
  voided          Boolean          @default(false)
  voidReason      String?          @db.Text
  voidedAt        DateTime?
  createdById     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  contact          Contact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)
  expenseCategory  ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  paymentMethodRel PaymentMethod?   @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([category])
  @@index([status])
  @@index([voided])
  @@index([contactId])
  @@index([createdAt])
  @@map("expenses")
}

model PaymentMethod {
  id          String    @id @default(uuid())
  name        String    @unique
  code        String?   @unique
  type        String    @default("BANK") // CASH, BANK, CARD, UPI, CHEQUE, OTHER
  description String?
  isDefault   Boolean   @default(false)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  expenses    Expense[]

  @@map("payment_methods")
}

enum JournalStatus {
  DRAFT
  POSTED
  VOID
}

model JournalEntry {
  id          String        @id @default(uuid())
  ref         String        @unique
  date        DateTime      @default(now())
  narration   String?       @db.Text
  status      JournalStatus @default(POSTED)
  totalDebit  Decimal       @default(0.00) @db.Decimal(12, 2)
  totalCredit Decimal       @default(0.00) @db.Decimal(12, 2)
  createdById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  lines       JournalLine[]

  @@index([date])
  @@index([status])
  @@map("journal_entries")
}

model JournalLine {
  id          String       @id @default(uuid())
  journalId   String
  accountCode String
  accountName String
  description String?      @db.Text
  debit       Decimal      @default(0.00) @db.Decimal(12, 2)
  credit      Decimal      @default(0.00) @db.Decimal(12, 2)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  journal     JournalEntry @relation(fields: [journalId], references: [id], onDelete: Cascade)

  @@index([accountCode])
  @@index([journalId])
  @@map("journal_lines")
}


