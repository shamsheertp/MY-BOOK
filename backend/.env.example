# Server Configuration
PORT=5000
NODE_ENV=production

# Database Connection (PostgreSQL, e.g. Railway, Supabase, Neon, AWS RDS)
# Tip for production: append ?connection_limit=10&pool_timeout=20 for optimal pooling
DATABASE_URL="postgresql://username:password@host:port/database?connection_limit=10&pool_timeout=20"

# Authentication Security
# Generate a secure 64-character secret in production using: openssl rand -base64 32
JWT_SECRET="your_production_jwt_secret_key_change_this"
JWT_EXPIRES_IN="7d"

# Allowed Frontend Origins (comma-separated for multiple origins)
# Example: https://app.yourdomain.com,https://mybook.vercel.app,http://localhost:5173
CLIENT_URL="https://app.yourdomain.com"

# Supervisor/Admin PIN for voiding journals and sensitive operations
ADMIN_PIN="1234"

# Cloudflare R2 Object Storage (Zero Egress Fees)
# Endpoint format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="mybook-documents"
# Public URL enabled in Cloudflare bucket settings (or custom domain)
R2_PUBLIC_URL="https://pub-xxxxxxxxxxxxxxxx.r2.dev"
