# Backend API Configuration
# For Local Development:
VITE_API_URL=http://localhost:5000/api

# For Production (choose one based on deployment strategy):
# 1. Same-domain or reverse proxy (recommended):
# VITE_API_URL=/api
# 2. Separate backend domain (e.g. Railway, Render, Fly.io):
# VITE_API_URL=https://your-api-domain.com/api
